# DeepSeek API 配置（复制为 .env 并填入真实值）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：推理强度 low / high / max（V4 Pro 支持，留空使用默认）
# 多 Agent（CrewAI）下建议 low，避免 reasoning 模型偶发返回空 content
DEEPSEEK_REASONING_EFFORT=low

# 可选：最大输出 token 数
DEEPSEEK_MAX_TOKENS=8192

# 可选：请求超时（秒）
DEEPSEEK_TIMEOUT=120

# Local application runtime; tests overwrite both values before importing the app.
APP_DB_MODE=app
APP_DB_PATH=data/duck_diary.db
